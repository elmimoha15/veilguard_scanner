{
  "safe/secret-names-in-prose": {
    "kind": "safe",
    "why": "Secret-looking variable NAMES in UI copy are teaching text, not leaks."
  },
  "safe/markdown-docs": {
    "kind": "safe",
    "why": "Docs and READMEs are examples."
  },
  "safe/placeholder-credentials": {
    "kind": "safe",
    "why": "Placeholder values (xxx, EXAMPLE, localhost defaults, YOUR_KEY) are not credentials."
  },
  "safe/public-by-design-keys": {
    "kind": "safe",
    "why": "Stripe pk_, Supabase anon/publishable, Firebase AIza, PostHog and Sentry DSNs are public by design."
  },
  "safe/json-ld-script": {
    "kind": "safe",
    "why": "JSON-LD structured data is not user HTML."
  },
  "safe/demo-showcase-component": {
    "kind": "safe",
    "why": "Marketing demo components render fake findings on purpose."
  },
  "safe/env-schema-keys": {
    "kind": "safe",
    "why": "Env-schema keys and error strings name variables without values."
  },
  "safe/style-css-injection": {
    "kind": "safe",
    "why": "Static CSS injected into a <style> tag is not XSS."
  },
  "safe/ssrf-fixed-host": {
    "kind": "safe",
    "why": "A fixed host with a user value only in the path is not SSRF (at most a low verify)."
  },
  "safe/ssrf-blocklist": {
    "kind": "safe",
    "why": "A metadata address inside a blocklist is the SSRF defence."
  },
  "safe/sql-constants-and-params": {
    "kind": "safe",
    "why": "Constant identifiers and positional parameters are not injection."
  },
  "safe/ui-copy-not-sql": {
    "kind": "safe",
    "why": "UI sentences that start with SELECT/DELETE words are not SQL."
  },
  "safe/regex-exec": {
    "kind": "safe",
    "why": "RegExp.exec is pattern matching, not SQL/command execution."
  },
  "safe/webhook-construct-event-async": {
    "kind": "safe",
    "why": "constructEventAsync with a differently-named client is valid verification; upserts are idempotent."
  },
  "safe/webhook-svix": {
    "kind": "safe",
    "why": "Svix verification is recognised."
  },
  "safe/chat-role-not-privilege": {
    "kind": "safe",
    "why": "An LLM chat message role is not a user privilege."
  },
  "safe/rls-public-catalog": {
    "kind": "safe",
    "why": "Public read of a product/price catalog is the intended design."
  },
  "safe/cors-split-routes": {
    "kind": "safe",
    "why": "A public \"*\" route and a separate credentialed allowlist are fine."
  },
  "safe/negated-ai-rules": {
    "kind": "safe",
    "why": "Negated instructions are the safe rule."
  },
  "safe/mapbox-token-env": {
    "kind": "safe",
    "why": "Mapbox public tokens are meant for the browser."
  },
  "safe/env-templates": {
    "kind": "safe",
    "why": "Template env files are meant to be committed."
  },
  "safe/pem-parser-code": {
    "kind": "safe",
    "why": "A PEM header with no key body is parsing code."
  },
  "safe/patched-next-lockfile": {
    "kind": "safe",
    "why": "The lockfile resolves a patched Next.js. (OSV is excluded here: it queries the live advisory database, which reports real later advisories for any pinned version; this case only tests the lockfile-aware native rule.)",
    "ignoreSources": [
      "osv-scanner"
    ]
  },
  "safe/middleware-enforced-auth": {
    "kind": "safe",
    "why": "Auth enforced in middleware protects the routes it matches."
  },
  "safe/content-learn-article": {
    "kind": "safe",
    "why": "Code samples inside article content are not running code."
  },
  "safe/tests-and-mocks": {
    "kind": "safe",
    "why": "Tests, fixtures and mocks are not shipped."
  },
  "safe/url-prose-bundle": {
    "kind": "safe",
    "url": {
      "headers": {
        "content-security-policy": "default-src 'self'; frame-ancestors 'none'",
        "strict-transport-security": "max-age=63072000",
        "x-content-type-options": "nosniff",
        "referrer-policy": "strict-origin-when-cross-origin",
        "permissions-policy": "camera=()"
      },
      "bundles": [
        "bundle.js"
      ]
    },
    "why": "veilguard.dev regression: secret names in article/demo text inside the bundle."
  },
  "safe/url-minified-env-names": {
    "kind": "safe",
    "url": {
      "headers": {
        "content-security-policy": "default-src 'self'; frame-ancestors 'none'",
        "strict-transport-security": "max-age=63072000",
        "x-content-type-options": "nosniff",
        "referrer-policy": "strict-origin-when-cross-origin",
        "permissions-policy": "camera=()"
      },
      "bundles": [
        "chunk.js"
      ]
    },
    "why": "Un-inlined env reads and error strings in a minified bundle carry no value."
  },
  "safe/url-public-config": {
    "kind": "safe",
    "url": {
      "headers": {
        "content-security-policy": "default-src 'self'; frame-ancestors 'none'",
        "strict-transport-security": "max-age=63072000",
        "x-content-type-options": "nosniff",
        "referrer-policy": "strict-origin-when-cross-origin",
        "permissions-policy": "camera=()"
      },
      "bundles": [
        "app.js"
      ],
      "responses": {}
    },
    "why": "Public config in a bundle; RLS probe returns no rows."
  },
