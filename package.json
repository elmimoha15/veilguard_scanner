{
  "name": "veilguard-scanner",
  "version": "0.1.0",
  "description": "Standalone security scanner for AI-built web/SaaS apps (Next.js + Supabase/Firebase + Stripe). Scans a live URL or a code repo and emits findings + an A–F grade.",
  "type": "module",
  "bin": {
    "veilguard": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist/", "semgrep-rules/", "README.md"],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "scan": "tsx src/cli.ts scan",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gate": "tsx test/gate.ts"
  },
  "keywords": ["security", "scanner", "sast", "supabase", "stripe", "nextjs"],
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@babel/parser": "^7.25.0",
    "@babel/traverse": "^7.25.0",
    "@babel/types": "^7.25.0",
    "cheerio": "^1.0.0",
    "commander": "^12.1.0",
    "execa": "^9.3.0",
    "fast-glob": "^3.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^20.14.0",
    "eslint": "^9.9.0",
    "typescript-eslint": "^8.0.0",
    "tsup": "^8.2.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
